{
	"compilerOptions": {
		"target": "es2023",
		"lib": ["es2023"],
		"module": "es2022",
		"moduleResolution": "bundler",
		"strict": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"skipLibCheck": true,
		"types": ["@cloudflare/workers-types"]
	},
	"include": ["./*.ts", "../src/terminal/market.ts", "../src/qvapay/*.ts", "../src/broker/*.ts", "../src/ratelimit.ts", "../src/log.ts"]
}
