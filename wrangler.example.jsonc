// Copia este archivo como wrangler.jsonc y pon tu base de datos y tus dominios.
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "terminal-p2p",
	"main": "worker/index.ts",
	"compatibility_date": "2026-10-15",

	// La lógica corre en el navegador: se empaqueta web/ en public/app/data.js
	"build": { "command": "npm run build:web", "watch_dir": ["web", "src"] },

	// Archivos estáticos: public/site (la landing, en el dominio principal) y
	// public/app (el terminal, en app.). El Worker atiende primero todas las
	// peticiones: elige la carpeta según el dominio, redirige www y hace de relé
	"assets": {
		"directory": "public",
		"binding": "ASSETS",
		"run_worker_first": true
	},


	// Histórico público de la tasa (solo agregados de QvaPay, sin datos de usuarios).
	// El cron lo alimenta cada 10 minutos con una única llamada sin token.
	"d1_databases": [
		{ "binding": "DB", "database_name": "terminal-p2p", "database_id": "<id de tu base D1>" }
	],
	// Topes por IP (la IP es solo la llave del contador; no se guarda): avisos de métricas y panel
	"ratelimits": [
		{ "name": "EVENT_LIMIT", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
		{ "name": "PANEL_LIMIT", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } },
		{ "name": "SIM_LIMIT", "namespace_id": "1003", "simple": { "limit": 60, "period": 60 } },
		{ "name": "PRO_LIMIT", "namespace_id": "1004", "simple": { "limit": 10, "period": 60 } },
		// Consulta de estado de Pro (por IP: muchos comparten IP en Cuba, por eso amplio) y relé (por cuenta)
		{ "name": "STATUS_LIMIT", "namespace_id": "1005", "simple": { "limit": 60, "period": 60 } },
		{ "name": "RELAY_LIMIT", "namespace_id": "1006", "simple": { "limit": 300, "period": 60 } }
	],
	// Plan Pro: la app de comerciante de QvaPay (facturas y quién pagó). El app-id no es secreto; el
	// app-secret y la clave de las licencias sí (npx wrangler secret put QVAPAY_APP_SECRET / PRO_KEY)
	// Módulo Pro (de un repositorio privado): se sube aquí y el Worker lo entrega solo con licencia
	"kv_namespaces": [{ "binding": "PRO", "id": "<id de tu espacio KV para el módulo Pro>" }],
	// ALERT_CHAT: el chat del grupo privado de avisos de Pro (con el bot dentro); el token del bot es secreto
	// COMMUNITY_CHAT: el grupo público de la comunidad, donde sale la «Tasa QvaPay del día» (se enciende en el panel)
	// (npx wrangler secret put TELEGRAM_BOT_TOKEN)
	"vars": { "QVAPAY_APP_ID": "<app-id de tu app de comerciante de QvaPay>", "ALERT_CHAT": "<id del grupo de avisos, p. ej. -100123…>", "COMMUNITY_CHAT": "<id del grupo de la comunidad>" },
	"triggers": { "crons": ["* * * * *"] },
	// Opcional: la referencia del mercado informal de elTOQUE necesita su clave como secreto
	// (npx wrangler secret put ELTOQUE_TOKEN). Sin ella, el cron solo guarda lo de QvaPay.
	// Opcional: métricas anónimas con METRICS_SALT (clave de las huellas) y METRICS_KEY (panel)

	"routes": [
		{ "pattern": "example.com", "custom_domain": true },
		{ "pattern": "www.example.com", "custom_domain": true },
		{ "pattern": "app.example.com", "custom_domain": true },
		{ "pattern": "sim.example.com", "custom_domain": true }
	],

	// Opcional: staging (npx wrangler deploy --env staging), otro Worker con su base, KV y dominios.
	// Los secretos se ponen aparte con --env staging
	"env": {
		"staging": {
			"name": "terminal-p2p-staging",
			"d1_databases": [
				{ "binding": "DB", "database_name": "terminal-p2p-staging", "database_id": "<id de la base D1 de staging>" }
			],
			"kv_namespaces": [{ "binding": "PRO", "id": "<id del KV de staging>" }],
			"ratelimits": [
				{ "name": "EVENT_LIMIT", "namespace_id": "2001", "simple": { "limit": 30, "period": 60 } },
				{ "name": "PANEL_LIMIT", "namespace_id": "2002", "simple": { "limit": 10, "period": 60 } },
				{ "name": "SIM_LIMIT", "namespace_id": "2003", "simple": { "limit": 60, "period": 60 } },
				{ "name": "PRO_LIMIT", "namespace_id": "2004", "simple": { "limit": 10, "period": 60 } },
				{ "name": "STATUS_LIMIT", "namespace_id": "2005", "simple": { "limit": 60, "period": 60 } },
				{ "name": "RELAY_LIMIT", "namespace_id": "2006", "simple": { "limit": 300, "period": 60 } }
			],
			"vars": { "STAGING": "1", "QVAPAY_APP_ID": "<app-id de la app de comerciante de staging>" },
			"routes": [
				{ "pattern": "staging.example.com", "custom_domain": true },
				{ "pattern": "app.staging.example.com", "custom_domain": true },
				{ "pattern": "sim.staging.example.com", "custom_domain": true }
			]
		}
	},

	// Solo errores de la app; sin registro por petición (URLs, IPs, cabeceras)
	"observability": { "enabled": true, "logs": { "invocation_logs": false } }
}
