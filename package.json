{
  "name": "terminal-p2p",
  "version": "0.1.0",
  "private": true,
  "description": "Terminal P2P: el mercado P2P de QvaPay como un exchange, en vivo",
  "type": "module",
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker && tsc --noEmit -p web",
    "test": "node --test test/",
    "dev": "wrangler dev --port 5177 --local-upstream app.localhost:5177 --upstream-protocol http --test-scheduled",
    "dev:sim": "wrangler dev --port 5180 --local-upstream sim.localhost:5180 --upstream-protocol http --test-scheduled",
    "dev:site": "wrangler dev --port 5179 --local-upstream localhost:5179 --upstream-protocol http --persist-to .wrangler/state-site",
    "deploy": "wrangler deploy",
    "vendor": "node scripts/vendor.mjs",
    "build:web": "esbuild web/main.ts --bundle --format=iife --target=es2022 --minify --sourcemap --outfile=public/app/data.js"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261022.1",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "lightweight-charts": "^4.2.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.152.0"
  },
  "allowScripts": {
    "workerd@1.20261019.1": true
  },
  "license": "Apache-2.0",
  "author": "osmely (https://github.com/osmely)",
  "homepage": "https://terminalp2p.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/osmely/terminal-p2p.git"
  }
}
